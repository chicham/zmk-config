#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <locale/keys_fr.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {

  // Activate ADJUST layer by pressing raise and lower
  conditional_layers {
    compatible = "zmk,conditional-layers";
    adjust_layer {
      if-layers = <LOWER RAISE>;
      then-layer = <ADJUST>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "BEPO";
      // BEPO letters over the French-PC (AZERTY) HID mapping — same trick the
      // Voyager QMK config used with FR_* keycodes, ported to zmk-locales' FR_* macros.
      // ------------------------------------------------------------------------------------------------------------
      // |  /   |  \   |  [   |  ]   |  (   |  )   |                    |   ?  |   !   |   ^   |      |       | BSPC |
      // | ESC  |  B   |  É   |  P   |  O   |  È   |                    |   V  |  D    |  L    |  J    |  Z    |  W   |
      // |  TAB  |  A   |  U   |  I   |  E   |  ,   |                    |   C  |  T    |  S    |  R    |  N    |  M   |
      // |       |  À   |  Y   |  X   |  .   |  K   | LOWER |  | RAISE  |   '  |  Q    |  G    |  H    |  F    |      |
      //               | SHFT | CTRL | ALT   |  GUI  |  SPC  |  |  ENTER   | GUI  | ALT  | CTRL | SHFT|
      // Reconciled with BÉPO: comma back on the home row (was ;, now on NUM
      // instead), v/d/l/j/z/w restored to row 2 in BÉPO order, ' moved next
      // to q (row 4, in the slot w vacated), circumflex dead-key (^, for
      // ê/â/î/ô/û) added to row 1 — true single-key ê isn't possible over
      // AZERTY/French-PC without switching macOS to a real BÉPO input source.
      // ESC stays put; SHIFT/CTRL moved off the main grid onto the thumb row.
      // LOWER/RAISE live on the two extra row-4 keys below each screen.
      bindings = <
        &kp FR_FSLH &kp FR_BSLH    &kp FR_LBKT &kp FR_RBKT &kp FR_LPAR &kp FR_RPAR                       &kp FR_QMARK &kp FR_EXCL &kp FR_CARET &none     &none      &kp BSPC
        &kp ESC     &kp B          &kp FR_E_ACUTE &kp P    &kp O       &kp FR_E_GRAVE                    &kp V        &kp D    &kp L     &kp J     &kp FR_Z  &kp FR_W
        &kp TAB     &kp FR_A       &kp U       &kp I       &kp E       &kp FR_COMMA                      &kp C        &kp T    &kp S     &kp R     &kp N     &kp FR_M
        &none       &kp FR_A_GRAVE &kp Y       &kp X       &kp FR_DOT  &kp K       &mo LOWER  &mo RAISE  &kp FR_APOSTROPHE &kp FR_Q &kp G &kp H     &kp F     &none
        &kp LSHFT &kp LCTRL &kp LALT &kp LGUI &kp SPACE     &kp RET &kp RGUI &kp RALT &kp RCTRL &kp RSHFT
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    lower_layer {
      display-name = "NUM";
      // Ported from Voyager layer 1 (numbers row + symbols).
      // ------------------------------------------------------------------------------------------------------------
      // |      |      |  [   |  ]   |  7   |  8   |                    |  ^   |  [   |  ]   |  7   |  8   |  9   |
      // |      |      |      |      |      |      |                    |  -   |  <   |  >   |  4   |  5   |  6   |
      // |      |      |  Ù   |      |      |      |                    |  Ç   |  |   |  &   |  1   |  2   |  3   |
      // |      |      |      |      |      |      |       |  |         |  ;   |  :   |  #   |  ~   |  0   |      |
      //               |      |      |      |      |       |  |         |      |      |      |      |
      bindings = <
        &trans &trans &trans     &trans &trans &trans                                     &kp FR_CARET &kp FR_LBKT &kp FR_RBKT &kp FR_N7    &kp FR_N8    &kp FR_N9
        &trans &trans &trans     &trans &trans &trans                                     &kp FR_MINUS &kp FR_LT   &kp FR_GT   &kp FR_N4    &kp FR_N5    &kp FR_N6
        &trans &trans &kp FR_U_GRAVE &trans &trans &trans                                 &kp FR_C_CEDILLA &kp FR_PIPE &kp FR_AMPERSAND &kp FR_N1 &kp FR_N2 &kp FR_N3
        &trans &trans &trans     &trans &trans &trans     &trans &trans                   &kp FR_SEMI &kp FR_COLON &kp FR_HASH &kp FR_TILDE &kp FR_N0 &trans
        &trans &trans      &trans    &trans     &trans &trans  &trans    &trans   &trans    &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    raise_layer {
      display-name = "SYM";
      // Ported from Voyager layer 2 (extra punctuation + RGB brightness).
      // ------------------------------------------------------------------------------------------------------------
      // |  +   |  -   |  /   |  *   |  =   |  %   |                    |      |      | BRI-  | BRI+ |      | INS  |
      // |      |  $   |  "   |  (   |  )   |  @   |                    |      |      |       |      |      |      |
      // |      |      |  _   |  ¨   |  `   |  '   |                    |      |      |       |      |      |      |
      // |      |  /   |  \   |  {   |  }   | RALT+SPC |     |  |       |      |      |       |      |      |      |
      //               |      |      |      |      |         |  |      | LEFT | DOWN |  UP   | RIGHT|
      bindings = <
        &kp FR_PLUS &kp FR_MINUS &kp FR_FSLH &kp FR_ASTRK &kp FR_EQUAL &kp FR_PERCENT                                          &trans &trans &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans &kp INS
        &trans      &kp FR_DOLLAR &kp FR_DOUBLE_QUOTES &kp FR_LPAR &kp FR_RPAR &kp FR_AT                                       &trans &trans &trans          &trans          &trans &trans
        &trans      &trans       &kp FR_UNDERSCORE &kp FR_UMLAUT &kp FR_GRAVE &kp FR_APOSTROPHE                               &trans &trans &trans          &trans          &trans &trans
        &trans      &kp FR_FSLH  &kp FR_BSLH &kp FR_LBRC &kp FR_RBRC &kp RA(SPACE)     &trans &trans                          &trans &trans &trans          &trans          &trans &trans
                                  &trans      &trans      &trans      &trans            &trans &trans                        &kp LEFT &kp DOWN &kp UP &kp RIGHT
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    adjust_layer {
      // ----------------------------------------------------------------------------------------------------------------------------
      // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
      // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
      // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       | STUD |       |       |
      // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
      //                    |         |         |         |         |         | |      |      |      |       |      |
      display-name = "ADJUST";
      bindings = <
        &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none
        &ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &none
        &none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &studio_unlock &none &none
        &none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &none  &none &none &none &none &none &none
        &none           &none           &none           &none            &none           &none  &none &none &none &none
      >;
    };
  };
};
